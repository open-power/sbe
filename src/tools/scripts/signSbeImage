# IBM_PROLOG_END_TAG

# Exit if any command fails
set -e

# Tool version , Update tool version based on release
TOOL_VERSION=2

# @brief Checks whether the file that is the input argument exists on the file
# system. The function
#        exits with an error status if the file DNE.
#
# @param[in] Full path to the file to check
check_path()
{
    if [ ! -f $1 ]; then
        echo "***ERROR | SBE | signSbeImage : $1 DNE!"
        exit -1
    fi
}

# @brief Pad zero's to a binary file to make it 8 byte aligned
#
# @param[in] Full path of the file to be padded
alignFileSize()
{
    ALIGN=8
    PAD_BYTE="\x00"

    FILESIZE=$(wc -c <"$1")
    echo " "
    echo "Size of $1 = $FILESIZE bytes."

    if [ $((FILESIZE % ALIGN)) -ne 0 ]; then
        echo "File: $1 unaligned. Aligning to nearest 8Byte."
        PAD_BYTES=$((ALIGN - (FILESIZE % ALIGN)))

        while [ $PAD_BYTES -ne 0 ]
            do
                echo -n -e $PAD_BYTE >> $1
                PAD_BYTES=$(($PAD_BYTES - 1))
            done

        FILESIZE=$(wc -c <"$1")
        echo "Size of $1 after alignment = $FILESIZE bytes."
    fi
}

# @brief Print the help/usage info to the console
usage()
{
    echo ""
    echo "Usage"
    echo "!!!RUN ON A RHEL8 MACHINE!!!"
    echo "TOOL VERSION : $TOOL_VERSION"
    echo "Sign SBE image"
    echo "signSbeImage -i <SBE image to sign> -t <IPL Image tool path> -s <scratch dir path> [-h ]"
    echo ""
    echo "Options are as below......................"
    echo "  -h: print this message."
    echo "  -s: scratch dir path."
    echo "  -i: SBE image to sign. "
    echo "  -t: IPL Image tool path."
    echo "  -S: Secure Version."
    echo "  -b: Build Type PNOR/STANDALONE (Default PNOR)."
    echo "  -d: SBE Image Dir path in op-build"
    echo "  -f: signing Mode. Production/Development(Default)"
    echo "  -v: Secure Boot Mode is v1/v3(v3 is default)"
}

while getopts "h?s:i:t:b:d:S:f:v:" opt;
do
    case $opt in

        h)
            usage
            exit 0
        ;;

        s)
            SCRATCH_DIR=$OPTARG
        ;;

        i)
            SBEBINSIMIMAGE=$OPTARG
        ;;

        t)
            IPL_IMAGE_TOOL=$OPTARG
        ;;

        b)
            BUILD_TYPE=$OPTARG
        ;;

	    d)
            SBE_IMG_DIR_OP=$OPTARG
        ;;

        S)
            SV=$OPTARG
        ;;

        f)
            SIGNING_MODE=$OPTARG
        ;;

        v)
            SECUREBOOT_MODE=$OPTARG
        ;;

        *)
            echo "Bad option: $OPTARG"
            usage
            exit -1
        ;;

    esac
done

#Check if user has passed all required arguments
if [ -z $SCRATCH_DIR ]; then
    echo "***ERROR | SBE | signSbeImage : Scratch directory path not set. Please supply the -s option."
    usage
    exit -1
fi

if [ -z $SBEBINSIMIMAGE ]; then
    echo "***ERROR | SBE | signSbeImage : SBE Image path not set. Please supply the -i option."
    usage
    exit -1
fi

if [ -z $IPL_IMAGE_TOOL ]; then
    echo "***ERROR | SBE | signSbeImage : IPL Image tool path not set. Please supply the -t option."
    usage
    exit -1
fi

if [ -z $BUILD_TYPE ]; then
    echo "***INFO | SBE | signSbeImage : Build Type not entered. Defaulting to PNOR build type"
    BUILD_TYPE="PNOR" #Default Build Type
fi

if [ -z $SECUREBOOT_MODE ]; then
    echo "***INFO | SBE | signSbeImage : Secure Boot Mode not entered. Defaulting v1 secure header"
    SECUREBOOT_MODE="${SECUREBOOT_MODE:-v1}" #Default Secure Boot Mode (v1 secure header).
fi

# Secure boot mode, it could be either v1 or v3
echo "***INFO | SBE | signSbeImage : Secure boot mode ... $SECUREBOOT_MODE"

# Based on user input , selecting secure boot mode , default is v1 secure mode
# Note: No other input expected from user apart from v1 or v3
if [ "$SECUREBOOT_MODE" == "v1" ]; then
    # If v1 secure header Secure Boot Mode => 0x0
    SB_MODE="\x00"

elif [ "$SECUREBOOT_MODE" == "v3" ] ;then
    # If v3 secure header Secure Boot Mode => 0x2
    SB_MODE="\x02"

else
    echo "***ERROR | SBE | signSbeImage : Invalid secure boot mode : $SECUREBOOT_MODE. Please supply the -v option."
    usage
    exit -1
fi

SIGNING_DIR=
V1_DEV_KEY_DIR=
V3_DEV_KEY_DIR=
V1_SIGNTOOL_ARGS=
V3_SIGNTOOL_ARGS=

# Determine if our path setup has been provided by the environment
if [ ! -z $SIGNING_BASE_DIR ]; then
    echo "***INFO | SBE | signSbeImage : Fetching signing tools from provided environment for V1/v3 signing"
    RH_DIR=`sed "s/^.*release \([0-9]*\).*$/rh\1/" /etc/redhat-release`
    SIGNING_DIR=$SIGNING_BASE_DIR/$RH_DIR/$SIGNING_UTILS_DIR
    V1_DEV_KEY_DIR=${SIGNING_BASE_DIR}/sb-signing-keys
    V3_DEV_KEY_DIR=${SIGNING_BASE_DIR}/sb-signing-keys

elif [ -z $SBE_IMG_DIR_OP ]; then

    if [ -n $SIGNING_RHEL_PATH ]; then
        echo "***INFO | SBE | signSbeImage : Not OP_build. Fetching keys and signing scripts."
        V1_DEV_KEY_DIR=${SIGNING_RHEL_PATH}/sb-signing-utils/test/keys/
        V3_DEV_KEY_DIR=${SIGNING_RHEL_PATH}/sb-signing-utils/test/v3_keys/
        SIGNING_DIR=${SIGNING_RHEL_PATH}/bin/
    else
        echo "***ERROR | SBE | SIGNING_RHEL_PATH env var is not defined"
        exit 1
    fi

else
    echo "***INFO | SBE | signSbeImage : OP_build. Fetching keys and signing scripts from OP-Build Tree"
    V1_DEV_KEY_DIR=${HOST_DIR}/etc/keys/
    V3_DEV_KEY_DIR=${HOST_DIR}/etc/v3_keys/
    SIGNING_DIR=${HOST_DIR}/usr/bin/
fi

# Adjust paths to pick up the signing tools
LD_LIBRARY_PATH=$LD_LIBRARY_PATH:$SIGNING_DIR
PATH=$SIGNING_DIR:$PATH

# Check for signing mode passed in by environment (p10)
if [ ! -z $BR2_OPENPOWER_P10_SECUREBOOT_SIGN_MODE ]; then
    SIGNING_MODE=$BR2_OPENPOWER_P10_SECUREBOOT_SIGN_MODE

# Check for signing mode passed in by environment (p9)
elif [ ! -z $BR2_OPENPOWER_SECUREBOOT_SIGN_MODE ]; then
    SIGNING_MODE=$BR2_OPENPOWER_SECUREBOOT_SIGN_MODE

# Check if user has passed signing mode
elif [ -z $SIGNING_MODE ]; then
    SIGNING_MODE="Development"
    echo "***INFO | SBE | signSbeImage : Defaulting signing mode to $SIGNING_MODE "
fi

# For P11 we will always do v1 as dev signing.
V1_SIGNTOOL_ARGS="$V1_SIGNTOOL_ARGS --mode development --flags 0x40080000 \
                --hwKeyA ${V1_DEV_KEY_DIR}/hw_key_a.key --hwKeyB ${V1_DEV_KEY_DIR}/hw_key_b.key \
                --hwKeyC ${V1_DEV_KEY_DIR}/hw_key_c.key --swKeyP ${V1_DEV_KEY_DIR}/sw_key_p.key "

# Set flag basis Development or production mode.
# Only v3 will be production signed.
# V1 can only be imprint signed
if [ "$SIGNING_MODE" = "Development" ]; then
    echo "***INFO | SBE | signSbeImage : Development Mode Signing"
    V3_SIGNTOOL_ARGS="$V3_SIGNTOOL_ARGS --mode development --flags 0x40080000 \
                    --hwKeyA ${V3_DEV_KEY_DIR}/runtime_hw_key_a.key  \
                    --hwKeyD ${V3_DEV_KEY_DIR}/runtime_hw_key_d.key  \
                    --swKeyP ${V3_DEV_KEY_DIR}/runtime_sw_key_p.key  \
                    --swKeyS ${V3_DEV_KEY_DIR}/runtime_sw_key_s.key  "

elif [ "$SIGNING_MODE" = "Production" ] ||
     [ "$SIGNING_MODE" = "production" ]; then
    echo "***INFO | SBE | signSbeImage : Production Mode Signing"

    if [ -z $SB_PROJECT_INI ] || [ ! -e $SB_PROJECT_INI ]; then
        echo "***ERROR | SBE | signSbeImage : Unable to locate production signing project ini file : $SB_PROJECT_INI"
        exit -1
    fi
    if [ -z $SB_ARCHIVE_IN ] || [ ! -e $SB_ARCHIVE_IN ]; then
        echo "***ERROR | SBE | signSbeImage : Unable to locate production signing key archive : $SB_ARCHIVE_IN"
        exit -1
    fi

    V3_SIGNTOOL_ARGS="$V3_SIGNTOOL_ARGS --mode production --flags 0x40000000 \
                --hwKeyA __getkey --hwKeyD __getkey --swKeyP __get --swKeyS __get \
                --sign-project-config $SB_PROJECT_INI --archiveIn $SB_ARCHIVE_IN"

    # Need path to SF client to access signing server
    PATH=$SIGNING_DIR/../sb-signing-framework/sb-signing-framework/src/client:$PATH

else
    echo "***ERROR | SBE | signSbeImage : Invalid signing mode option: $SIGNING_MODE. Enter correct -f option"
    usage
    exit -1
fi

# Determine secure version setting
if [ -z $SV ]; then
    # Build process can pass in the secure version through the environment
    if [ ! -z $SIGNING_SECURITY_VERSION ]; then
        SV=$SIGNING_SECURITY_VERSION
        echo "***INFO | SBE | signSbeImage : SV(Secure Version) passed via " \
             "SIGNING_SECURITY_VERSION as $SV"
    elif [ ! -z $BR2_OPENPOWER_SIGNED_SECURITY_VERSION ]; then
        SV=$BR2_OPENPOWER_SIGNED_SECURITY_VERSION
        echo "***INFO | SBE | signSbeImage : SV(Secure Version) passed via " \
             "BR2_OPENPOWER_SIGNED_SECURITY_VERSION as $SV"
    else
        SV=0
        echo "***INFO | SBE | signSbeImage : SV(Secure Version) not entered. Defaulting to $SV"
    fi
else
    echo "***INFO | SBE | signSbeImage : SV( Secure Version) entered: $SV"
fi

# Do some sanity checks on things we expect the script to consume
check_path ${V1_DEV_KEY_DIR}/hw_key_a.key
check_path ${V1_DEV_KEY_DIR}/hw_key_b.key
check_path ${V1_DEV_KEY_DIR}/hw_key_c.key
check_path ${V1_DEV_KEY_DIR}/sw_key_p.key
check_path ${V3_DEV_KEY_DIR}/runtime_hw_key_a.key
check_path ${V3_DEV_KEY_DIR}/runtime_hw_key_d.key
check_path ${V3_DEV_KEY_DIR}/runtime_sw_key_p.key
check_path ${V3_DEV_KEY_DIR}/runtime_sw_key_s.key
check_path ${IPL_IMAGE_TOOL}
check_path ${SBEBINSIMIMAGE}
check_path ${SIGNING_DIR}/crtSignedContainer.sh

#Create the scratch dir
mkdir -p ${SCRATCH_DIR}

printf "\nSign SBE Image\n"

if [ "$BUILD_TYPE" = "STANDALONE" ]; then

    # Extract .hbbl section from SBE image
    $IPL_IMAGE_TOOL $SBEBINSIMIMAGE extract .hbbl $SCRATCH_DIR/hbbl.bin || exit -1

    # Sign the .hbbl binary
    echo "Sign .hbbl section"
    # Sign the .hbbl binary for v1
    CMD="$SIGNING_DIR/crtSignedContainer.sh --scratchDir ${SCRATCH_DIR} $V1_SIGNTOOL_ARGS \
        --sign-project-FW-token HBBL --protectedPayload ${SCRATCH_DIR}/hbbl.bin \
        --contrHdrOut ${SCRATCH_DIR}/V1_SBE_HBBL.header \
        --security-version $SV --validate -V 1"
    echo "$CMD"
    $CMD

    #Strip out padding zeros from SBE_HBBL.header i.e only 1282 bytes is actual data. Keep it 8 byte alligned i.e 1288
    echo "Strip SBE_HBBL.header content"
    dd bs=1 count=1288 if=${SCRATCH_DIR}/V1_SBE_HBBL.header of=${SCRATCH_DIR}/V1_SBE_HBBL_stripped.header

    # copy v1 secure header content in final header file
    cat ${SCRATCH_DIR}/V1_SBE_HBBL_stripped.header > ${SCRATCH_DIR}/V1_V3_HBBL_FW_SECURE.header

    # Sign the .hbbl binary for v3
    CMD="$SIGNING_DIR/crtSignedContainer.sh --scratchDir ${SCRATCH_DIR} $V3_SIGNTOOL_ARGS \
        --sign-project-FW-token HBBL --protectedPayload ${SCRATCH_DIR}/hbbl.bin \
        --contrHdrOut ${SCRATCH_DIR}/V3_SBE_HBBL.header \
        --security-version $SV --validate -V 3"
    echo "$CMD"
    $CMD

    # Appending v3 secure header in final header file
    cat ${SCRATCH_DIR}/V3_SBE_HBBL.header >> ${SCRATCH_DIR}/V1_V3_HBBL_FW_SECURE.header

    # Append the stripped V1_V3_HBBL_FW_SECURE.header into .sbh_hbbl xip section
    echo "Appending secure header into .sbh_hbbl xip section"
    $IPL_IMAGE_TOOL $SBEBINSIMIMAGE delete .sbh_hbbl
    $IPL_IMAGE_TOOL $SBEBINSIMIMAGE append .sbh_hbbl $SCRATCH_DIR/V1_V3_HBBL_FW_SECURE.header || exit -1

elif [ "$BUILD_TYPE" = "PNOR" ]; then

    echo "Skipping signing of HBBL section....."

else

    echo "***ERROR | SBE | signSbeImage : Invalid Build Type entered : $BUILD_TYPE. Please supply the -t option."
    usage
    exit -1

fi

# Extract .base section from SBE image
$IPL_IMAGE_TOOL $SBEBINSIMIMAGE extract .base $SCRATCH_DIR/base.bin || exit -1

# Align all files which are related to FW secure HDR to overcome alignment issues
# During sha2-512 and sha3-512 calculation in verification process.
alignFileSize $SCRATCH_DIR/base.bin

# Rename base.bin to sbe_fw.bin
mv $SCRATCH_DIR/base.bin $SCRATCH_DIR/sbe_fw.bin

# Sign the SBE firmware binary image(payload.bin) for v1 secure header
CMD="$SIGNING_DIR/crtSignedContainer.sh --scratchDir ${SCRATCH_DIR} $V1_SIGNTOOL_ARGS \
    --sign-project-FW-token SBE_FW --protectedPayload ${SCRATCH_DIR}/sbe_fw.bin \
    --contrHdrOut ${SCRATCH_DIR}/V1_SBE_FW.header \
    --security-version $SV --validate -V 1"
echo "$CMD"
$CMD

# Strip out padding zeros from V1_SBE_FW.header i.e only 1282 bytes is actual data. Keep it 8 byte alligned i.e 1288
echo "Strip V1_SBE_FW.header content"
dd bs=1 count=1288 if=${SCRATCH_DIR}/V1_SBE_FW.header of=${SCRATCH_DIR}/V1_SBE_FW_stripped.header

# Copy v1 secure header content in final header file
cat ${SCRATCH_DIR}/V1_SBE_FW_stripped.header > ${SCRATCH_DIR}/V1_V3_SBE_FW_SECURE.header

# Sign the SBE firmware binary image(payload.bin) for v3 secure header
CMD="$SIGNING_DIR/crtSignedContainer.sh --scratchDir ${SCRATCH_DIR} $V3_SIGNTOOL_ARGS \
    --sign-project-FW-token SBE_FW --protectedPayload ${SCRATCH_DIR}/sbe_fw.bin \
    --contrHdrOut ${SCRATCH_DIR}/V3_SBE_FW.header \
    --security-version $SV --validate -V 3"
echo "$CMD"
$CMD

# Appending v3 secure header in final header file
cat ${SCRATCH_DIR}/V3_SBE_FW.header >> ${SCRATCH_DIR}/V1_V3_SBE_FW_SECURE.header

# Append the V1_V3_SBE_FW_SECURE.header into .sbh_firmware xip section
echo "Appending secure header into .sbh_firmware xip section"
$IPL_IMAGE_TOOL $SBEBINSIMIMAGE delete .sbh_firmware
$IPL_IMAGE_TOOL $SBEBINSIMIMAGE append .sbh_firmware $SCRATCH_DIR/V1_V3_SBE_FW_SECURE.header || exit -1

# Converting secure boot mode from lower case to upper case
# To simplifies HW key has generation for v1 and v3
declare -u HW_KEY_HASH=$SECUREBOOT_MODE

# Hash of the HW keys. Fetch the value from any of the secure container which is created.
# We need to filter out the HW keys from the print container output and convert the output to .bin format
print-container -w0 --imagefile ${SCRATCH_DIR}/${HW_KEY_HASH}_SBE_FW.header | grep -A1 "HW keys hash" | grep "           " | head -1 | tr -d " " | tr -d "\n" | xxd -r -p > $SCRATCH_DIR/hw_keys_hash.bin

# Append minimum secure version(MSV), SB Mode and reserved bytes
# into .sb_settings xip section after HW key hash
RESERVED="\x00\x00\x00\x00\x00\x00"

SB_SV=`printf %02x $SV`
SB_SV="\x${SB_SV}"

echo "Appending SV $SB_SV, SB Mode $SB_MODE and reserved bytes $RESERVED to .sb_settings"
echo -n -e $SB_SV$SB_MODE$RESERVED >> $SCRATCH_DIR/hw_keys_hash.bin
echo $SCRATCH_DIR

# Append the HW key hash into .sb_settings xip section
echo "Appending HW key hash into .sb_settings xip section"
$IPL_IMAGE_TOOL $SBEBINSIMIMAGE delete .sb_settings
$IPL_IMAGE_TOOL $SBEBINSIMIMAGE append .sb_settings $SCRATCH_DIR/hw_keys_hash.bin || exit -1

# Lets delete the scratch dir
rm -rf $SCRATCH_DIR

echo "SBE Image Signed Successfully"
echo " "

exit 0
